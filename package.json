{
  "name": "qualityloop",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint --ext .js,.jsx src scripts",
    "test": "jest --runInBand",
    "build": "node scripts/build.js",
    "eval:dev": "node scripts/eval-predict.js --data eval/dev --corpus eval/corpus/capas.json --out dist/eval/dev-predictions.json && node eval/reference/score.js --split dev --data eval/dev --predictions dist/eval/dev-predictions.json"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^30.5.2"
  },
  "dependencies": {
    "@forge/api": "^8.4.0",
    "@forge/bridge": "7.2.1",
    "@forge/kvs": "^2.1.1",
    "@forge/react": "12.4.0",
    "@forge/resolver": "2.0.2",
    "react": "^18.2.0"
  }
}
